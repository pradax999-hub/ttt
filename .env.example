# Transfer by Van Backend Configuration
PORT=3000
CLIENT_URL=http://localhost:3000

# Add a Stripe test key first. No local imitation of card payment is used.
STRIPE_SECRET_KEY=
# Add this AFTER deployment and registering /api/webhook in Stripe.
STRIPE_WEBHOOK_SECRET=

# Email Configuration (SMTP для відправки підтверджень клієнтам)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Only a sender address verified by your SMTP provider. Defaults to EMAIL_USER.
EMAIL_FROM=
# The operator receives a copy of each booking at this real address.
DISPATCH_EMAIL=

# Driver Tracking (координати від драйвер-додатку)
DRIVER_UPDATE_INTERVAL_MS=5000
# Private operator key, minimum 32 random characters. Never send it to drivers.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DRIVER_ADMIN_TOKEN=

# Geoapify autocomplete + Places API (hotels like "diplomat", stations, addresses).
# Key stays ONLY on the server in GEOAPIFY_API_KEY — never paste it into index.html.
# Get it at https://myprojects.geoapify.com/ → your project → API key.
# After setting it, restart: npm start. Test: type "diplomat" in Kam/To field.
GEOAPIFY_API_KEY=

# Empty uses public OSRM for evaluation, not production traffic.
# Point to your own or contracted OSRM service for launch.
OSRM_URL=
# Absolute path on a persistent private volume for production, e.g. /data/orders.json
# Leave empty for local data.json. Never place this file on a public static host.
DATA_FILE=
# Set only when your trusted reverse-proxy chain is known; 0 for direct access.
TRUST_PROXY_HOPS=0

# Контакт (показується клієнту на сайті)
PHONE=
WHATSAPP=
SUPPORT_EMAIL=

# ДАНІ РЕЙСУ в реальному часі (опціонально)
# aviationstack: https://aviationstack.com (verify the plan and integration before use)
# flightsfrom:    https://flightsfrom.com
FLIGHT_PROVIDER=aviationstack
FLIGHT_API_KEY=

# Platba: PayPal.me nickname (paypal.me/NICK). Empty = PayPal disabled.
PAYPAL_ME=
# PayPal Merchant ID (used when PAYPAL_ME is empty)
PAYPAL_MERCHANT_ID=52C4EWHSTRW3S
# Account for QR payment (SPAYD). IBAN is derived automatically.
PAYMENT_ACCOUNT=4160775073/0800
PAYMENT_IBAN=
